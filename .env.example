# ============================================================
# CyberScore API environment variables
# ============================================================
# Copy this file to apps/api/.env (NOT the repo root). In
# production we put the same keys into Vercel under Project
# Settings then Environment Variables.
#
# Anything sensitive must never be committed. The .env files
# are gitignored at every level. Verify with:
#   git log --all --full-history --source -- '*/.env'
# That command should print nothing.
# ============================================================

NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Local dev points to a local Postgres 16 running on default
# port. In production both URLs come from Neon (the pooled URL
# and the direct URL respectively). Prisma uses the direct
# URL for migrations and the pooled URL for runtime queries.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberscore?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberscore?schema=public

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
# Used for rate limits, idempotency, and the BullMQ job queues.
# Local: redis://localhost:6379
# Production: a rediss:// URL from Upstash.
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# JWT and refresh tokens
# ------------------------------------------------------------
# Both secrets must be at least 32 characters. Generate them
# with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_64_char_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

# ------------------------------------------------------------
# TOTP encryption
# ------------------------------------------------------------
# Used to encrypt TOTP secrets at rest. 64 hex chars (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=replace_with_64_hex_chars

# ------------------------------------------------------------
# AI chat advisor
# ------------------------------------------------------------
# Default in production is the local rule-based advisor. It
# is free, needs no API key, and gives sector-aware answers
# grounded in your real scorecard.
#
# Set USE_LOCAL_ADVISOR=false to call Anthropic Claude instead.
# You then must set the API key and have credit on the account.
USE_LOCAL_ADVISOR=true

# Only needed when USE_LOCAL_ADVISOR=false:
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
# ANTHROPIC_MODEL_FALLBACK=claude-haiku-4-5
# ANTHROPIC_DAILY_BUDGET_USD=50
# AI_FREE_DAILY_CALLS=20

# ------------------------------------------------------------
# Object storage (Cloudflare R2 or any S3-compatible store)
# ------------------------------------------------------------
# Used for evidence file uploads. The API issues a presigned
# PUT URL valid for 5 minutes, scoped to a tenant prefix.
# Leave these unset to skip evidence uploads in dev.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cyberscore-evidence
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://evidence.cyberscore.app

# ------------------------------------------------------------
# Email delivery (OTP, invites, password reset)
# ------------------------------------------------------------
# The lib auto-detects the provider from the SMTP_PASS prefix:
#   xkeysib-*   goes through Brevo HTTPS API
#   re_*        goes through Resend HTTPS API
#   anything    falls back to nodemailer SMTP
#
# We use Brevo HTTP in production because Vercel serverless
# functions are unreliable on raw TCP for ports 465 and 587.
# Emails would sit in connection limbo until the function
# timed out.
#
# For local dev: leave SMTP_PASS empty to fall back to
# nodemailer's JSON transport. That just logs the email body
# to the console, no real send. For real emails locally either
# sign up at Brevo and use a dev API key, or use Mailtrap.
SMTP_HOST=smtp.relay.brevo.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM="CyberScore <no-reply@cyberscore.app>"

# ------------------------------------------------------------
# Expo push notifications
# ------------------------------------------------------------
# Get the access token from https://expo.dev under Access tokens.
# Leave empty to skip push notification sending in dev.
EXPO_ACCESS_TOKEN=

# ------------------------------------------------------------
# Observability (Sentry)
# ------------------------------------------------------------
# Leave empty in dev. In production we set a DSN per environment.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ------------------------------------------------------------
# Rate limits
# ------------------------------------------------------------
# Per IP per window. The login limit is intentionally tight to
# protect against credential stuffing. Other limits live in
# apps/api/src/lib/rate-limit.ts.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# ------------------------------------------------------------
# Optional demo-user seed overrides
# ------------------------------------------------------------
# Used by apps/api/scripts/seed-demo-user.ts. If unset, the
# defaults seed saanvi.vishal@iiitb.ac.in as a verified admin.
# DEMO_EMAIL=saanvi.vishal@iiitb.ac.in
# DEMO_PASSWORD=cyberscore-demo-2026
# DEMO_ORG_NAME=IIIT Bangalore
# DEMO_INDUSTRY=Banking
# DEMO_NAME=Saanvi Vishal
